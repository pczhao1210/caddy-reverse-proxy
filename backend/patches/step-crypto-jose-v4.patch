+func TestMigrationPreservesX25519KeyID(t *testing.T) {
+	_, private, err := x25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := JSONWebKey{Key: private, KeyID: "existing-nebula-key"}
+	signer, err := NewSigner(SigningKey{Algorithm: XEdDSA, Key: &key}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signed, err := signer.Sign([]byte("migration"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	signed, err = ParseJWS(signed.FullSerialize())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if signed.Signatures[0].Header.KeyID != key.KeyID {
+		t.Fatal("X25519 key ID was not preserved")
+	}
+	if _, err := signed.Verify(X25519Verifier(private.Public().(x25519.PublicKey))); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := NewSigner(SigningKey{Algorithm: XEdDSA, Key: &key}, &SignerOptions{EmbedJWK: true}); err == nil {
+		t.Fatal("unsupported X25519 JWK embedding must not be accepted")
+	}
+}
