+func TestMigrationPreservesBuilderFormats(t *testing.T) {
+	key := []byte("01234567890123456789012345678901")
+	signer, err := NewSigner(SigningKey{Algorithm: HS256, Key: key}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value := Signed(signer).Claims(Claims{Subject: "migration", Audience: Audience{"a", "b"}})
+	for _, serialize := range []func() (string, error){value.Serialize, value.CompactSerialize, value.FullSerialize} {
+		serialized, err := serialize()
+		if err != nil {
+			t.Fatal(err)
+		}
+		token, err := ParseSigned(serialized)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var claims Claims
+		if err := token.Claims(key, &claims); err != nil {
+			t.Fatal(err)
+		}
+		if claims.Subject != "migration" {
+			t.Fatalf("subject = %q", claims.Subject)
+		}
+		if err := claims.Validate(Expected{Audience: Audience{"a", "b"}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
