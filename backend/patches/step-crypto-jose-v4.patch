+func TestMigrationPreservesAudienceValidation(t *testing.T) {
+	now := time.Now().UTC()
+	for _, test := range []struct {
+		name     string
+		claims   Claims
+		expected Expected
+		want     error
+	}{
+		{"all present", Claims{Audience: Audience{"a", "b", "c"}}, Expected{Audience: Audience{"a", "b"}}, nil},
+		{"partial is rejected", Claims{Audience: Audience{"a"}}, Expected{Audience: Audience{"a", "b"}}, ErrInvalidAudience},
+		{"empty is rejected", Claims{}, Expected{Audience: Audience{"a"}}, ErrInvalidAudience},
+		{"wrong is rejected", Claims{Audience: Audience{"b"}}, Expected{Audience: Audience{"a"}}, ErrInvalidAudience},
+		{"unspecified", Claims{}, Expected{}, nil},
+		{"issuer before audience", Claims{}, Expected{Issuer: "issuer", Audience: Audience{"a"}}, ErrInvalidIssuer},
+		{"audience before expiry", Claims{Audience: Audience{"a"}, Expiry: NewNumericDate(now.Add(-time.Hour))}, Expected{Audience: Audience{"a", "b"}}, ErrInvalidAudience},
+		{"expiry enforced", Claims{Audience: Audience{"a"}, Expiry: NewNumericDate(now.Add(-time.Hour))}, Expected{Audience: Audience{"a"}}, ErrExpired},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if err := test.claims.ValidateWithLeeway(test.expected.WithTime(now), 0); !errors.Is(err, test.want) {
+				t.Fatalf("ValidateWithLeeway() = %v, want %v", err, test.want)
+			}
+		})
+	}
+}
