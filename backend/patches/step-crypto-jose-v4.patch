+func TestMigrationRejectsMismatchedEd25519Keys(t *testing.T) {
+	for _, file := range []string{"testdata/okp.priv.json", "testdata/okp.enc.priv.json"} {
+		if _, err := ReadKey(file, WithPassword([]byte("password"))); err == nil {
+			t.Fatalf("%s: accepted an Ed25519 public key that does not match the private seed", file)
+		}
+	}
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := JSONWebKey{Key: private}
+	data, err := json.Marshal(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := ParseKey(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !parsed.Key.(ed25519.PrivateKey).Equal(private) {
+		t.Fatal("valid Ed25519 private key did not round-trip")
+	}
+	privateThumbprint, err := Thumbprint(&key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	publicThumbprint, err := Thumbprint(&JSONWebKey{Key: public})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if privateThumbprint != publicThumbprint {
+		t.Fatal("valid Ed25519 public/private thumbprints differ")
+	}
+	encrypted, err := EncryptJWK(&key, []byte("migration-only-password"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ParseKey([]byte(encrypted.FullSerialize()), WithPassword([]byte("migration-only-password"))); err != nil {
+		t.Fatal(err)
+	}
